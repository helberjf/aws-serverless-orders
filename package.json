{
  "name": "aws-serverless-orders",
  "version": "1.1.0",
  "private": true,
  "description": "Event-driven order processing with AWS SAM, Lambda, DynamoDB Streams and SQS",
  "repository": "https://github.com/helberjf/aws-serverless-orders",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "npm run typecheck",
    "lint": "eslint .",
    "lint:check": "npm run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "build": "sam build",
    "validate": "sam validate --lint"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/client-sqs": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
